import GaugeGaps.StringTension
import Mathlib.Analysis.SpecialFunctions.Log.Deriv

/-!
# String tension of the SU(2) ladder on a tiling of `[0, 12]`: certificates

Generated by `tension/gen_lean_tension.py`. Each entry is a coupling interval `[la, lb]`, two inverse temperatures
`β₁ < β`, rational bounds on the four inputs of Lemma 6 at the two endpoints, and a certified `σ`:
`ωa, ωb` lower bounds on the lowest odd-sector level on 2 plaquettes; `ℓa, ℓb` upper bounds on `log Z₊(2, β₁)`;
`θa, θb` upper bounds on the lowest even-sector level on 2 plaquettes; `ε` an upper bound on the spatial defect of
the even sector at `β` on the whole interval. The kernel checks that `σ` is at most the bound of Lemma 6 at both
endpoints, with `-log (1 - x)` replaced by the rational upper bound `x + x²/2 + x³/3 + x⁴/4 + x⁵/(1 - x)`.
`tension_on_interval` is `string_tension` applied at the point `(1 - t) la + t lb` of an interval: for ANY two
families of spectra satisfying the moment inequalities and the four input bounds interpolated linearly in `t`,
every level of the second family on an even ring of length `L ≥ 2` lies at least `σ L` above the lowest level of
the first. That the two winding sectors of the ladder satisfy these hypotheses is the content of Lemmas 1 to 5 of
the note and of the numerics (two implementations); it is not proved here.
-/

open Real CertifiedGaps

namespace GaugeGaps.Tension

/-- An interval with the certified inputs of Lemma 6 at its endpoints. -/
structure TInterval where
  la : ℚ
  lb : ℚ
  β : ℚ
  β₁ : ℚ
  ωa : ℚ
  ωb : ℚ
  ℓa : ℚ
  ℓb : ℚ
  θa : ℚ
  θb : ℚ
  ε : ℚ
  σ : ℚ

/-- Rational upper bound on `-log (1 - x)` for `0 ≤ x < 1`. -/
def logBar (x : ℚ) : ℚ := x + x ^ 2 / 2 + x ^ 3 / 3 + x ^ 4 / 4 + x ^ 5 / (1 - x)

/-- The squaring map on defects, in rationals. -/
def sqDef (x : ℚ) : ℚ := x ^ 2 / (2 * (1 - x) ^ 2)

/-- The bound of Lemma 6 with `logBar` in place of the logarithms. -/
def sigmaAt (ω ℓ θ ε β β₁ : ℚ) : ℚ :=
  ω / 2 - (ℓ / 2 + β * θ / 2 + (logBar ε + logBar (sqDef ε)) / 4) / (β - β₁)

/-- The rational checks on one entry. -/
def okB (I : TInterval) : Bool :=
  decide (0 < I.β₁) && decide (I.β₁ < I.β) && decide (0 ≤ I.ε) && decide (I.ε < 1) &&
  decide (sqDef I.ε ≤ 1 / 2) && decide (I.la < I.lb) &&
  decide (I.σ ≤ sigmaAt I.ωa I.ℓa I.θa I.ε I.β I.β₁) && decide (I.σ ≤ sigmaAt I.ωb I.ℓb I.θb I.ε I.β I.β₁)

/-- `tilesB l a b`: the intervals of `l` start at `a`, each ends where the next starts, the last ends at `b`. -/
def tilesB : List TInterval → ℚ → ℚ → Bool
  | [], a, b => decide (a = b)
  | I :: l, a, b => decide (I.la = a) && (decide (I.la < I.lb) && tilesB l I.lb b)

theorem exists_mem_of_tilesB {l : List TInterval} {a b : ℚ} (h : tilesB l a b = true) (hab : a < b) (x : ℝ)
    (hax : (a : ℝ) ≤ x) (hxb : x ≤ (b : ℝ)) : ∃ I ∈ l, (I.la : ℝ) ≤ x ∧ x ≤ (I.lb : ℝ) := by
  induction l generalizing a with
  | nil =>
    have : a = b := by simpa [tilesB] using h
    exact absurd this (ne_of_lt hab)
  | cons I l ih =>
    simp only [tilesB, Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨hIa, hI, hl⟩ := h
    by_cases hx : x ≤ (I.lb : ℝ)
    · exact ⟨I, List.mem_cons_self, by rw [hIa]; exact hax, hx⟩
    · have hx' : (I.lb : ℝ) < x := lt_of_not_ge hx
      have hlt : I.lb < b := by exact_mod_cast lt_of_lt_of_le hx' hxb
      obtain ⟨J, hJ, hJx⟩ := ih hl hlt (le_of_lt hx')
      exact ⟨J, List.mem_cons_of_mem _ hJ, hJx⟩

/-- `-log (1 - x) ≤ x + x²/2 + x³/3 + x⁴/4 + x⁵/(1 - x)` for `0 ≤ x < 1`. -/
theorem neg_log_one_sub_le {x : ℝ} (h0 : 0 ≤ x) (h1 : x < 1) :
    -log (1 - x) ≤ x + x ^ 2 / 2 + x ^ 3 / 3 + x ^ 4 / 4 + x ^ 5 / (1 - x) := by
  have habs : |x| < 1 := by rw [abs_of_nonneg h0]; exact h1
  have h := Real.abs_log_sub_add_sum_range_le habs 4
  rw [abs_of_nonneg h0] at h
  have h' := (abs_le.mp h).1
  simp only [Finset.sum_range_succ, Finset.sum_range_zero] at h'
  norm_num at h'
  linarith

/-- The real bound of Lemma 6 is at least its rational version. -/
theorem sigmaAt_le {ω ℓ θ ε β β₁ : ℚ} (hε0 : 0 ≤ ε) (hε1 : ε < 1) (hf : sqDef ε ≤ 1 / 2) (hβ : β₁ < β) :
    ((sigmaAt ω ℓ θ ε β β₁ : ℚ) : ℝ) ≤ (ω : ℝ) / 2 - ((ℓ : ℝ) / 2 + (β : ℝ) * θ / 2
      - log (1 - (ε : ℝ)) / 4 - log (1 - squaringDefect (ε : ℝ)) / 4) / ((β : ℝ) - β₁) := by
  have hε0' : (0 : ℝ) ≤ ε := by exact_mod_cast hε0
  have hε1' : (ε : ℝ) < 1 := by exact_mod_cast hε1
  have hsq : ((sqDef ε : ℚ) : ℝ) = squaringDefect (ε : ℝ) := by
    simp [sqDef, squaringDefect]
  have hf0 : (0 : ℝ) ≤ squaringDefect (ε : ℝ) := by unfold squaringDefect; positivity
  have hf1 : squaringDefect (ε : ℝ) < 1 := by
    have h := (Rat.cast_le (K := ℝ)).mpr hf
    rw [hsq] at h; push_cast at h; linarith
  have h1 := neg_log_one_sub_le hε0' hε1'
  have h2 := neg_log_one_sub_le hf0 hf1
  have hd : (0 : ℝ) < (β : ℝ) - β₁ := by
    have : (β₁ : ℝ) < β := by exact_mod_cast hβ
    linarith
  have hcast : ((sigmaAt ω ℓ θ ε β β₁ : ℚ) : ℝ) = (ω : ℝ) / 2 - ((ℓ : ℝ) / 2 + (β : ℝ) * θ / 2
      + (((ε : ℝ) + (ε : ℝ) ^ 2 / 2 + (ε : ℝ) ^ 3 / 3 + (ε : ℝ) ^ 4 / 4 + (ε : ℝ) ^ 5 / (1 - (ε : ℝ)))
        + (squaringDefect (ε : ℝ) + squaringDefect (ε : ℝ) ^ 2 / 2 + squaringDefect (ε : ℝ) ^ 3 / 3
          + squaringDefect (ε : ℝ) ^ 4 / 4 + squaringDefect (ε : ℝ) ^ 5 / (1 - squaringDefect (ε : ℝ)))) / 4)
      / ((β : ℝ) - β₁) := by
    rw [← hsq]; simp [sigmaAt, logBar]
  rw [hcast]
  have hnum : (ℓ : ℝ) / 2 + (β : ℝ) * θ / 2 - log (1 - (ε : ℝ)) / 4 - log (1 - squaringDefect (ε : ℝ)) / 4
      ≤ (ℓ : ℝ) / 2 + (β : ℝ) * θ / 2
      + (((ε : ℝ) + (ε : ℝ) ^ 2 / 2 + (ε : ℝ) ^ 3 / 3 + (ε : ℝ) ^ 4 / 4 + (ε : ℝ) ^ 5 / (1 - (ε : ℝ)))
        + (squaringDefect (ε : ℝ) + squaringDefect (ε : ℝ) ^ 2 / 2 + squaringDefect (ε : ℝ) ^ 3 / 3
          + squaringDefect (ε : ℝ) ^ 4 / 4 + squaringDefect (ε : ℝ) ^ 5 / (1 - squaringDefect (ε : ℝ)))) / 4 := by
    linarith
  have := div_le_div_of_nonneg_right hnum hd.le
  linarith

