set_option maxRecDepth 1000000 in
theorem intervals_length : intervals.length = 180 := by decide +kernel

set_option maxRecDepth 1000000 in
theorem intervals_ok : ∀ I ∈ intervals, okB I = true := by decide +kernel

set_option maxRecDepth 1000000 in
/-- The intervals tile `[0, 12]`. -/
theorem intervals_tile : tilesB intervals 0 12 = true := by decide +kernel

/-- Every coupling in `[0, 12]` lies in one of the intervals. -/
theorem exists_interval (x : ℝ) (h0 : 0 ≤ x) (h1 : x ≤ 12) : ∃ I ∈ intervals, (I.la : ℝ) ≤ x ∧ x ≤ (I.lb : ℝ) :=
  exists_mem_of_tilesB intervals_tile (by norm_num) x (by exact_mod_cast h0) (by exact_mod_cast h1)

/-- **String tension on an interval.** `Ep`, `Em`: the spectra of two sectors at the coupling `(1 - t) la + t lb`. -/
theorem tension_on_interval {ι : ℕ → Type*} [∀ L, Fintype (ι L)] [∀ L, Nonempty (ι L)]
    {κ : ℕ → Type*} [∀ L, Fintype (κ L)] [∀ L, Nonempty (κ L)]
    (Ep : (L : ℕ) → ι L → ℝ) (Em : (L : ℕ) → κ L → ℝ)
    (hZp : HasSpatialMomentBounds Ep 2) (hZm : HasSpatialMomentBounds Em 2)
    {I : TInterval} (hI : I ∈ intervals) {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (hω : ∀ m, (1 - t) * (I.ωa : ℝ) + t * I.ωb ≤ Em 2 m)
    (hℓ : log (partitionFunction Ep 2 I.β₁) ≤ (1 - t) * (I.ℓa : ℝ) + t * I.ℓb)
    (hθ : ∃ m, Ep 2 m ≤ (1 - t) * (I.θa : ℝ) + t * I.θb)
    (hε : 1 - (I.ε : ℝ) ≤ spatialPurity Ep 2 I.β) {L : ℕ} (hL : 2 ≤ L) (hLe : Even L) (m : κ L) :
    ∃ m₀, (∀ m', Ep L m₀ ≤ Ep L m') ∧ (L : ℝ) * (I.σ : ℝ) ≤ Em L m - Ep L m₀ := by
  have hok := intervals_ok I hI
  simp only [okB, Bool.and_eq_true, decide_eq_true_eq] at hok
  obtain ⟨⟨⟨⟨⟨⟨⟨hβ₁, hβ⟩, hε0⟩, hε1⟩, hf⟩, _⟩, hσa⟩, hσb⟩ := hok
  have hβ₁' : (0 : ℝ) < I.β₁ := by exact_mod_cast hβ₁
  have hβ' : (I.β₁ : ℝ) < I.β := by exact_mod_cast hβ
  have hε1' : (I.ε : ℝ) < 1 := by exact_mod_cast hε1
  have hsq : ((sqDef I.ε : ℚ) : ℝ) = squaringDefect (I.ε : ℝ) := by simp [sqDef, squaringDefect]
  have hf' : squaringDefect (I.ε : ℝ) ≤ 1 / 2 := by
    have h := (Rat.cast_le (K := ℝ)).mpr hf
    rw [hsq] at h; push_cast at h; linarith
  obtain ⟨m₀, hmin, hmain⟩ := StringTension.string_tension Ep Em hZp hZm hβ₁' hβ' hε1' hf' hℓ hθ hε hω hL hLe m
  refine ⟨m₀, hmin, le_trans ?_ hmain⟩
  have ha := sigmaAt_le (ω := I.ωa) (ℓ := I.ℓa) (θ := I.θa) hε0 hε1 hf hβ
  have hb := sigmaAt_le (ω := I.ωb) (ℓ := I.ℓb) (θ := I.θb) hε0 hε1 hf hβ
  have hσa' : (I.σ : ℝ) ≤ ((sigmaAt I.ωa I.ℓa I.θa I.ε I.β I.β₁ : ℚ) : ℝ) := by exact_mod_cast hσa
  have hσb' : (I.σ : ℝ) ≤ ((sigmaAt I.ωb I.ℓb I.θb I.ε I.β I.β₁ : ℚ) : ℝ) := by exact_mod_cast hσb
  have hLpos : (0 : ℝ) ≤ L := by positivity
  apply mul_le_mul_of_nonneg_left _ hLpos
  have hd : (0 : ℝ) < (I.β : ℝ) - I.β₁ := by linarith
  -- the real bound at t is the convex combination of the two endpoint bounds
  have hcomb : (I.ωa * (1 - t) + I.ωb * t : ℝ) / 2 - (((I.ℓa * (1 - t) + I.ℓb * t : ℝ)) / 2
      + (I.β : ℝ) * (I.θa * (1 - t) + I.θb * t) / 2 - log (1 - (I.ε : ℝ)) / 4
      - log (1 - squaringDefect (I.ε : ℝ)) / 4) / ((I.β : ℝ) - I.β₁)
      = (1 - t) * ((I.ωa : ℝ) / 2 - ((I.ℓa : ℝ) / 2 + (I.β : ℝ) * I.θa / 2 - log (1 - (I.ε : ℝ)) / 4
          - log (1 - squaringDefect (I.ε : ℝ)) / 4) / ((I.β : ℝ) - I.β₁))
        + t * ((I.ωb : ℝ) / 2 - ((I.ℓb : ℝ) / 2 + (I.β : ℝ) * I.θb / 2 - log (1 - (I.ε : ℝ)) / 4
          - log (1 - squaringDefect (I.ε : ℝ)) / 4) / ((I.β : ℝ) - I.β₁)) := by
    field_simp
    ring
  have e1 : (1 - t) * (I.ωa : ℝ) + t * I.ωb = I.ωa * (1 - t) + I.ωb * t := by ring
  have e2 : (1 - t) * (I.ℓa : ℝ) + t * I.ℓb = I.ℓa * (1 - t) + I.ℓb * t := by ring
  have e3 : (1 - t) * (I.θa : ℝ) + t * I.θb = I.θa * (1 - t) + I.θb * t := by ring
  rw [e1, e2, e3, hcomb]
  nlinarith [mul_le_mul_of_nonneg_left (hσa'.trans ha) (sub_nonneg.mpr ht1),
    mul_le_mul_of_nonneg_left (hσb'.trans hb) ht0]

end GaugeGaps.Tension
