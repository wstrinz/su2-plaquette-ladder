/-- **A spectral gap with no hypothesis** (sharper bound): every ring of even length `L ≥ 2` has a
nondegenerate ground state and a gap above `log r / β₀`. -/
theorem gap_fine {L : ℕ} (hL : 2 ≤ L) (hLe : Even L) :
    GapGT ((model 1 1).spectrum L) (log (certFine.r : ℝ) / (43 / 8)) := by
  have hs : 1 - ((certFine.sAt 0 : ℚ) : ℝ) ≤ (model 1 1).spatialPurity 2 (43 / 8) := by
    convert seed_spatial_fine using 2
    norm_num [certFine, ChainCertificate.sAt]
  have ht : 1 - ((certFine.tAt 0 : ℚ) : ℝ) ≤ (model 1 1).thermalPurity (2 * 2) (43 / 8) := by
    convert seed_thermal_fine using 2
    norm_num [certFine, ChainCertificate.tAt]
  exact (model 1 1).gapGT_of_chainCertificate (n₀ := 2) le_rfl (by decide) (by norm_num)
    certFine_valid ⟨rfl, rfl, rfl⟩ hs ht hL hLe

