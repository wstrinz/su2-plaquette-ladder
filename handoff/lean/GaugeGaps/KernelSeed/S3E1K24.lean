/-! ### Low spectra and seeds -/

noncomputable abbrev rad : ℝ := 1 / ((10 ^ 6 : ℕ) : ℝ)
noncomputable abbrev θ2 : ℝ := (lam2 : ℝ) / ((T.den : ℝ) * (scale : ℝ))
noncomputable abbrev θ4 : ℝ := (lam4 : ℝ) / ((T.den : ℝ) * (scale : ℝ))
noncomputable abbrev ρ2 : ℝ := (cut2 : ℝ) / (T.den : ℝ)
noncomputable abbrev ρ4 : ℝ := (cut4 : ℝ) / (T.den : ℝ)

theorem low2 : LowSpectrum ((model 1 24).spectrum 2) (θ2 - rad) (θ2 + rad) ρ2 :=
  lowSpectrum_of_check rep scale (by norm_num [scale]) le_rfl v2 lam2 (10 ^ 6) (by norm_num)
    dot2_pos res2 cut2 count2 (by norm_num [lam2, scale, cut2, tables])

theorem low4 : LowSpectrum ((model 1 24).spectrum 4) (θ4 - rad) (θ4 + rad) ρ4 :=
  lowSpectrum_of_check rep scale (by norm_num [scale]) (by norm_num) v4 lam4 (10 ^ 6)
    (by norm_num) dot4_pos res4 cut4 count4 (by norm_num [lam4, scale, cut4, tables])

/-- **The spatial seed**, with no hypothesis. -/
theorem seed_spatial : 1 - (2082e-5 : ℝ) ≤ (model 1 24).spatialPurity 2 (3 / 4) :=
  seed_spatial_of (by norm_num) low2 low4 15 (by norm_num [θ2, ρ2, rad, lam2, scale, cut2, tables])
    (by norm_num [θ2, θ4, rad, lam2, lam4, scale, tables])

/-- **The thermal seed**, with no hypothesis. -/
theorem seed_thermal : 1 - (1575e-5 : ℝ) ≤ (model 1 24).thermalPurity 4 (3 / 4) :=
  seed_thermal_of (by norm_num) low4 12 (by norm_num [θ4, ρ4, rad, lam4, scale, cut4, tables])
    (by norm_num [θ4, rad, lam4, scale, cut4, tables])

theorem cert_valid : cert.Valid := by decide +kernel

/-- **A spectral gap with no hypothesis**: every ring of even length `L ≥ 2` has a nondegenerate
ground state and a gap above `log r / β₀`. -/
theorem gap {L : ℕ} (hL : 2 ≤ L) (hLe : Even L) :
    GapGT ((model 1 24).spectrum L) (log (cert.r : ℝ) / (3 / 4)) := by
  have hs : 1 - ((cert.sAt 0 : ℚ) : ℝ) ≤ (model 1 24).spatialPurity 2 (3 / 4) := by
    convert seed_spatial using 2
    norm_num [cert, ChainCertificate.sAt]
  have ht : 1 - ((cert.tAt 0 : ℚ) : ℝ) ≤ (model 1 24).thermalPurity (2 * 2) (3 / 4) := by
    convert seed_thermal using 2
    norm_num [cert, ChainCertificate.tAt]
  exact (model 1 24).gapGT_of_chainCertificate (n₀ := 2) le_rfl (by decide) (by norm_num)
    cert_valid ⟨rfl, rfl, rfl⟩ hs ht hL hLe

