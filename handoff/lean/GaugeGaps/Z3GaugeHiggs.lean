import CertifiedGaps.Ring.Gap
import CertifiedGaps.ChainCheck
import GaugeGaps.RatMat

/-!
# The `ℤ₃` lattice gauge–Higgs chain as a reflection-positive ring

One-dimensional lattice gauge theory with gauge group `ℤ₃` and `ℤ₃`-valued matter, in unitary gauge:
a ring of links, each carrying `w ∈ ℤ₃`, with
`H_L = -(1/2) ∑ⱼ ∑_{h ≠ 0} R_h(j) L_h(j+1) - (e/2) ∑ⱼ ∑_{h ≠ 0} L_h(j) - κ ∑ⱼ Re χ(wⱼ)`,
where `R_h |w⟩ = |w + h⟩`, `L_h |w⟩ = |w - h⟩` and `χ(w) = exp(2πi w/3)`. The matter kinetic
coefficient is the unit of energy.

With `A = R₁ + R₂`, `B = R₁ - R₂` and the inversion `F` (`w ↦ -w`), the bond term is
`-(1/4) (A ⊗ F A F + B ⊗ F B F)`, which is the reflection-positive form with the internal
reflection `F`. `A` is symmetric and `B` is antisymmetric.
-/

open Matrix Real CertifiedGaps

namespace GaugeGaps.Z3GaugeHiggs

/-- `A = R₁ + R₂`. -/
def Aq : Matrix (Fin 3) (Fin 3) ℤ := !![0, 1, 1; 1, 0, 1; 1, 1, 0]
/-- `B = R₁ - R₂`. -/
def Bq : Matrix (Fin 3) (Fin 3) ℤ := !![0, -1, 1; 1, 0, -1; -1, 1, 0]
/-- The inversion `w ↦ -w`. -/
def Fq : Matrix (Fin 3) (Fin 3) ℤ := !![1, 0, 0; 0, 0, 1; 0, 1, 0]
/-- `2 Re χ(w)`: `diag(2, -1, -1)`. -/
def Dq : Matrix (Fin 3) (Fin 3) ℤ := !![2, 0, 0; 0, -1, 0; 0, 0, -1]
/-- The shift `R₁ : |w⟩ ↦ |w + 1⟩`. -/
def R1q : Matrix (Fin 3) (Fin 3) ℤ := !![0, 0, 1; 1, 0, 0; 0, 1, 0]

theorem Aq_eq : Aq = R1q + R1qᵀ := by decide +kernel
theorem Bq_eq : Bq = R1q - R1qᵀ := by decide +kernel
theorem Aq_transpose : Aqᵀ = Aq := by decide +kernel
theorem Bq_transpose : Bqᵀ = -Bq := by decide +kernel
theorem Dq_transpose : Dqᵀ = Dq := by decide +kernel
theorem Fq_transpose : Fqᵀ = Fq := by decide +kernel
theorem Fq_sq : Fq * Fq = 1 := by decide +kernel
theorem Fq_Aq : Fq * Aq * Fq = Aq := by decide +kernel
theorem Fq_Bq : Fq * Bq * Fq = -Bq := by decide +kernel
theorem Fq_Dq : Fq * Dq * Fq = Dq := by decide +kernel
/-- The left shift is the reflected right shift: `L₁ = F R₁ F = R₁ᵀ`. -/
theorem Fq_R1q : Fq * R1q * Fq = R1qᵀ := by decide +kernel

/-- The `ℤ₃` gauge–Higgs chain with electric coupling `e` and hopping `κ`, as a reflection-positive
ring: bond factors `A/2` and `B/2`, on-site term `-(e/2) A - (κ/2) (2D)`, internal reflection `F`. -/
noncomputable def model (e κ : ℝ) : RPRing (Fin 3) (Fin 2) where
  C α := if α = 0 then (1 / 2 : ℝ) • castM Aq else (1 / 2 : ℝ) • castM Bq
  o := -(e / 2) • castM Aq - (κ / 2) • castM Dq
  C_symm α := by
    by_cases h : α = 0
    · left; simp [h, transpose_smul, castM_transpose, Aq_transpose]
    · right; simp [h, transpose_smul, castM_transpose, Bq_transpose, castM_neg]
  o_symm := by
    simp [transpose_sub, transpose_smul, castM_transpose, Aq_transpose, Dq_transpose]
  refl := castM Fq
  refl_symm := by rw [castM_transpose, Fq_transpose]
  refl_sq := by rw [← castM_mul, Fq_sq, castM_one]
  refl_o := by
    have hA : castM Fq * castM Aq * castM Fq = castM Aq := by rw [castM_conj, Fq_Aq]
    have hD : castM Fq * castM Dq * castM Fq = castM Dq := by rw [castM_conj, Fq_Dq]
    rw [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_smul,
      Matrix.smul_mul, hA, hD]

/-- A certified point: the couplings, the seed inverse temperature `β₀` (the seed length is `n₀ = 2`)
and the chain certificate, whose first entries are the seed defects. -/
structure Point where
  /-- The electric coupling. -/
  e : ℚ
  /-- The hopping (Higgs) coupling. -/
  κ : ℚ
  /-- The seed inverse temperature. -/
  β₀ : ℚ
  /-- The chain certificate. -/
  cert : ChainCertificate

/-- The certified points. The chain certificates are generated by the upstream script
`lean/scripts/chain_certificate.jl` from the seed defects of the certificates in `models/gauge_higgs`. -/
def points : List Point := [
  -- bound ≈ 1.3043
  ⟨1, 1, 2 / 1, {
    s := [3262e-5, 2649e-6, 1445e-8, 4179e-13, 3493e-22, 2441e-40, 1192e-76, 2842e-149, 1616e-294]
    t := [3914e-6, 5567e-8, 7913e-12, 132e-18, 3495e-35, 2444e-66, 1195e-128, 2857e-253, 1633e-502]
    r := 1358e-2
    ε := 1616e-294 }⟩,
  -- bound ≈ 1.9281
  ⟨1, 1 / 2, 5 / 2, {
    s := [3848e-6, 3214e-8, 2078e-12, 8637e-21, 1492e-37, 4453e-71, 3966e-138, 3146e-272, 198e-539]
    t := [2744e-7, 1689e-10, 5776e-17, 6674e-30, 8909e-56, 1588e-107, 5044e-211, 5089e-418, 518e-831]
    r := 124
    ε := 198e-539 }⟩,
  -- bound ≈ 3.1451
  ⟨2, 1, 3 / 2, {
    s := [278e-5, 3245e-8, 2979e-12, 196e-19, 7755e-37, 1203e-69, 2895e-135, 1677e-266, 5625e-529]
    t := [2452e-6, 1228e-8, 3017e-13, 1821e-22, 6633e-41, 88e-76, 1549e-151, 4799e-299, 4607e-594]
    r := 1119e-1
    ε := 5625e-529 }⟩,
  -- bound ≈ 5.8967
  ⟨4, 1, 5 / 4, {
    s := [1334e-7, 1246e-10, 6377e-17, 1138e-29, 2843e-55, 163e-105, 5315e-209, 565e-413, 6385e-824]
    t := [2321e-7, 1079e-10, 2329e-17, 1085e-30, 2355e-57, 111e-109, 2465e-217, 1216e-430, 2958e-857]
    r := 1589
    ε := 6385e-824 }⟩]

/-- All certificates are valid, checked by the kernel. -/
theorem points_valid : ∀ p ∈ points, p.cert.Valid := by decide +kernel

/-- Every seed inverse temperature is positive. -/
theorem points_β₀_pos : ∀ p ∈ points, 0 < p.β₀ := by decide +kernel

/-- The seed inequalities: for every point, `P_s(2, β₀) ≥ 1 - εₛ` and `P_τ(4, β₀) ≥ 1 - εₜ`.
They are certified outside Lean, by the CertifiedGaps Julia core (`certify_point`, complete spectra of the
rings of 2 and 4 links with rigorous eigenvalue enclosures), and enter here as a hypothesis. -/
def Seeds : Prop := ∀ p ∈ points,
    1 - (p.cert.sAt 0 : ℝ) ≤ (model p.e p.κ).spatialPurity 2 p.β₀ ∧
      1 - (p.cert.tAt 0 : ℝ) ≤ (model p.e p.κ).thermalPurity 4 p.β₀

/-- **The `ℤ₃` gauge–Higgs chain.** Given the seeds, at every certified point every even ring of
`L ≥ 2` links has a unique ground state and gap `Δ_L > log r / β₀`. -/
theorem gap (hseeds : Seeds) {p : Point} (hp : p ∈ points) {L : ℕ} (hL : 2 ≤ L) (hLe : Even L) :
    GapGT ((model p.e p.κ).spectrum L) (log (p.cert.r : ℝ) / p.β₀) :=
  (model p.e p.κ).gapGT_of_chainCertificate (n₀ := 2) (by norm_num) (by decide)
    (by exact_mod_cast points_β₀_pos p hp) (points_valid p hp) ⟨rfl, rfl, rfl⟩ (hseeds p hp).1
    (hseeds p hp).2 hL hLe

end GaugeGaps.Z3GaugeHiggs
